{
  "name": "@rutan/mini-random",
  "version": "0.3.1",
  "description": "A tiny random number generator",
  "keywords": [
    "random"
  ],
  "homepage": "https://github.com/rutan/rutan-game-utils/tree/main/packages/mini-random#readme",
  "bugs": {
    "url": "https://github.com/rutan/rutan-game-utils/issues"
  },
  "license": "WTFPL",
  "author": "rutan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rutan/rutan-game-utils.git",
    "directory": "packages/mini-random"
  },
  "directories": {
    "test": "test"
  },
  "files": [
    "dist/**/*",
    "src/**/*"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "run-s lint:*",
    "lint:oxfmt": "oxfmt -c ../../.oxfmtrc.json --check",
    "lint:oxlint": "oxlint",
    "lint:ts": "tsc --noEmit",
    "test": "vitest run",
    "format": "oxfmt -c ../../.oxfmtrc.json",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "rimraf": "^6.0.1"
  }
}
