{
  "name": "@rutan/deployment-zip",
  "version": "0.8.0",
  "description": "A CLI tool to create a deployment zip file.",
  "homepage": "https://github.com/rutan/rutan-game-utils/tree/main/packages/deployment-zip#readme",
  "bugs": {
    "url": "https://github.com/rutan/rutan-game-utils/issues"
  },
  "license": "MIT",
  "author": "ru_shalm <ru_shalm@hazimu.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rutan/rutan-game-utils.git",
    "directory": "packages/deployment-zip"
  },
  "bin": {
    "deployment-zip": "bin/deployment-zip"
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./plugins/insertTagToHTMLHeadPlugin": {
      "types": "./dist/plugins/insertTagToHTMLHeadPlugin.d.mts",
      "import": "./dist/plugins/insertTagToHTMLHeadPlugin.mjs"
    }
  },
  "scripts": {
    "start": "node ./bin/deployment-zip",
    "dev": "jiti ./src/cli.ts",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "run-s lint:*",
    "lint:oxfmt": "oxfmt -c ../../.oxfmtrc.json --check .",
    "lint:oxlint": "oxlint .",
    "lint:tsc": "tsc",
    "format": "run-s format:*",
    "format:oxfmt": "oxfmt -c ../../.oxfmtrc.json .",
    "format:oxlint": "oxlint --fix ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@aws-sdk/credential-provider-node": "^3.972.80",
    "@aws-sdk/lib-storage": "^3.1113.0",
    "archiver": "^8.0.0",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "ignore": "^7.0.6",
    "jiti": "^2.7.0",
    "mime": "^4.1.0",
    "node-html-parser": "^9.0.1"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
