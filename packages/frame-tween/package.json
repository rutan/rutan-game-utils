{
  "name": "@rutan/frame-tween",
  "version": "0.7.0",
  "description": "A simple tween animation for fixed frame rate games",
  "keywords": [
    "animation",
    "tween"
  ],
  "homepage": "https://github.com/rutan/rutan-game-utils/tree/main/packages/frame-tween#readme",
  "bugs": {
    "url": "https://github.com/rutan/rutan-game-utils/issues"
  },
  "license": "WTFPL",
  "author": "rutan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rutan/rutan-game-utils.git",
    "directory": "packages/frame-tween"
  },
  "directories": {
    "test": "test"
  },
  "files": [
    "dist/**/*",
    "src/**/*"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "run-s lint:*",
    "lint:oxfmt": "oxfmt -c ../../.oxfmtrc.json --check",
    "lint:oxlint": "oxlint",
    "lint:ts": "tsc --noEmit",
    "test": "vitest run",
    "format": "oxfmt -c ../../.oxfmtrc.json",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "rimraf": "^6.0.1"
  }
}
